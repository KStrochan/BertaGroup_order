# Скопіюйте цей файл у .env та заповніть актуальні значення.
# Ніколи не публікуйте .env і не додавайте його в Git.
# У цьому файлі мають бути ЛИШЕ заглушки: справжні ключі тримайте тільки
# у .env (він у .gitignore) та у змінних середовища на хостингу (Render).

PORT=3000

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=-1004299599812

# Session Secret
# Довільний довгий випадковий рядок (мінімум 32 символи) — підписує сесії клієнтів.
# Без нього сервер створює тимчасовий і розлогінює всіх клієнтів при кожному перезапуску.
# Згенерувати можна командою: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Upstash Redis Database (REST API) — безкоштовна база для клієнтів і замовлень.
# Візьміть ці значення з панелі Upstash: ваша база -> Details -> REST API.
# Якщо ці змінні не задані, сервер зберігає дані в локальних JSON-файлах у папці ./data
# (підходить лише для розробки на комп'ютері; на Render такі дані не переживуть перезапуск).
# UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN
